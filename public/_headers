# Vite emits content-hashed filenames under /assets, so they can never go
# stale — cache them until the heat death of the universe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point is the one unhashed file. If it gets cached, new deploys
# never reach anyone.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Required in production before the param bus can move to SharedArrayBuffer
# (see vite.config.ts, which already sets these on the dev server). Uncomment
# both at once. Note that require-corp also blocks any cross-origin
# subresource that doesn't explicitly opt in via CORP/CORS.
#  Cross-Origin-Opener-Policy: same-origin
#  Cross-Origin-Embedder-Policy: require-corp
