{
  "name": "fresyn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run check:fast && npm run build && wrangler pages deploy dist --project-name=fresyn",
    "check": "node scripts/run-checks.mjs all",
    "check:fast": "node scripts/run-checks.mjs fast",
    "check:browser-all": "node scripts/run-checks.mjs browser",
    "check:dsp": "node scripts/run-ts.mjs check-dsp",
    "check:patch": "node scripts/run-ts.mjs check-patch",
    "check:render": "node scripts/run-ts.mjs check-render",
    "check:song": "node scripts/run-ts.mjs check-song",
    "check:manual": "node scripts/run-ts.mjs check-manual",
    "check:instruments": "node scripts/run-ts.mjs check-instruments",
    "check:modules": "node scripts/run-ts.mjs check-modules",
    "check:theme": "node scripts/check-theme.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:cables": "node scripts/check-cables.mjs",
    "check:input": "node scripts/check-input.mjs",
    "check:rack": "node scripts/check-rack.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:roll": "node scripts/check-roll.mjs",
    "check:sampler": "node scripts/check-sampler.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "check:timing": "node scripts/check-timing.mjs",
    "check:kit": "node scripts/check-kit.mjs",
    "check:tools": "node scripts/check-tools.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.136.1"
  }
}
